# Portfolio site URL (used in footer, etc.)
APP_URL=http://localhost:8055

# Comma-separated backend health URLs to ping on portfolio load (server-only).
# Leave empty locally so you don't warm production from dev.
# PROJECT_SERVER_URLS=https://aegis.example.com/api/healthz,https://other.example.com/healthz
PROJECT_SERVER_URLS=

# Keystatic CMS storage: "local" (or unset) edits files on disk; admin only served in dev.
# "github" = edits commit to content/* branches on GitHub (merge via PR). Needs the four vars below,
# which Keystatic's /keystatic setup flow writes for you.
NEXT_PUBLIC_KEYSTATIC_STORAGE=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
